    {
      "name": "single object",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test(\"Response time is less than 1000ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
              "\r",
              "});\r",
              "// 3. Response is an object (not an array)\r",
              "pm.test(\"Response is an object (not an array)\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.be.an(\"object\").and.not.an(\"array\");\r",
              "});\r",
              "\r",
              "// 4. Response has required fields: \"id\" and \"name\"\r",
              "pm.test(\"Response has required fields: id and name\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property(\"id\");\r",
              "    pm.expect(jsonData).to.have.property(\"name\");\r",
              "});\r",
              "\r",
              "// 5. \"id\" is a string\r",
              "pm.test(\"id is a string\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.id).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "// 6. \"name\" is a string\r",
              "pm.test(\"name is a string\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.name).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "// 7. Response has a \"data\" property\r",
              "pm.test(\"Response has a data property\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property(\"data\");\r",
              "});\r",
              "\r",
              "// 8. Content-Type header includes \"application/json\"\r",
              "pm.test(\"Content-Type header includes application/json\", function () {\r",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
              "});"
            ],
